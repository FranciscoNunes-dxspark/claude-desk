{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Desk",
  "version": "0.2.3",
  "identifier": "com.dxspark.claudedesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claude Desk",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#141413"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzRkJEN0ZCM0Y0NUE0MjkKUldRcHBFVS8rOWY3dzFMZ2YvVFg5NmtxZCtmem0zUlg4V1hudWNmanpjRWRhTVVSQ28zeVdxZlIK",
      "endpoints": [
        "https://github.com/FranciscoNunes-dxspark/claude-desk/releases/latest/download/latest.json"
      ]
    }
  }
}
